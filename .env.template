# Local open-source edition. Copy this file to .env on the first run.
# No Firebase credentials or sign-in configuration are used in this edition.
# Never commit .env or real API keys.

# One persistent workspace on this computer, outside public web assets.
CHROMASCRIBE_DATA_DIR=.private/runtime
CHROMASCRIBE_PUBLIC_BASE_URL=http://127.0.0.1:5001
CHROMASCRIBE_PORT=5001
CHROMASCRIBE_DEBUG=false

# Optional stable session secret; this is not a login password.
# Generate one with: python -c 'import secrets; print(secrets.token_hex(32))'
CHROMASCRIBE_SECRET_KEY=

# Local Ollama: install/start Ollama and run `ollama pull qwen3:latest`.
# The /v1 path enables its OpenAI-compatible API. No key is needed locally.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:latest
LLM_API_KEY=

# For hosted AI, REPLACE the three LLM_* values above with your own settings.
# Keep only one active value for each variable. Examples of base URLs:
# Google AI Studio: https://generativelanguage.googleapis.com/v1beta/openai
# Groq: https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
# Choose a text chat model your account can access and use that provider's key.
# Hosted AI requests send transcript content to your selected provider.

# Optional diagnostic logging for Q&A tagging.
CHROMA_DEBUG_TAGGING=false
